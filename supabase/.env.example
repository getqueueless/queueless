# cp .env.example .env && sh generate-keys.sh --update-env   (rewrites .env in place, leaves .env.old)
# Placeholders below MUST be replaced; .env and .env.old are gitignored.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long-xxxxxxxx
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me
SECRET_KEY_BASE=change-me-64-chars
REALTIME_DB_ENC_KEY=change-me-16char
# Password for the least-privilege `queueless_api` Postgres role (apps/api connects as this role,
# never as postgres). Not touched by generate-keys.sh -- set both yourself.
QUEUELESS_API_PASSWORD=change-me
# 0018 creates the role with QUEUELESS_API_PASSWORD; 0031 (via migrate.sh) then resets it to this value, which wins.
QUEUELESS_API_DB_PASSWORD=change-me

# URLs (local). VPS later: https://api.lpu.lol, https://api.lpu.lol/auth/v1, https://lpu.lol
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,https://lpu.lol/**,queueless://**,exp://**
JWT_EXPIRY=3600

KONG_HTTP_PORT=8000
POSTGRES_HOST_PORT=54322
# Empty locally (load test signs in many users from one IP). Behind Cloudflare: CF-Connecting-IP
GOTRUE_RATE_LIMIT_HEADER=

# Email OTP (patient signup/login). Empty SMTP_HOST = emails silently never send (GoTrue noop mailer) --
# keep MAILER_AUTOCONFIRM=true locally when these are blank. On the VPS these are real and
# MAILER_AUTOCONFIRM=false, so a login actually requires the emailed code.
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@lpu.lol
SMTP_SENDER_NAME=Queueless

# Google sign-in. GOOGLE_ENABLED must be exactly "true" or "false" -- GoTrue's config loader
# fails to boot on an empty string for this field (verified: crashes the whole auth container,
# not just Google login), so it's its own explicit flag rather than derived from the client id.
# Real client id/secret live only in the VPS's own .env.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
