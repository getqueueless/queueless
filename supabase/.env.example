# cp .env.example .env && sh generate-keys.sh --update-env   (rewrites .env in place, leaves .env.old)
# Placeholders below MUST be replaced; .env and .env.old are gitignored.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long-xxxxxxxx
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me
SECRET_KEY_BASE=change-me-64-chars
REALTIME_DB_ENC_KEY=change-me-16char

# URLs (local). VPS later: https://api.lpu.lol, https://api.lpu.lol/auth/v1, https://lpu.lol
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,queueless://**,exp://**
JWT_EXPIRY=3600

KONG_HTTP_PORT=8000
POSTGRES_HOST_PORT=54322
# Empty locally (load test signs in many users from one IP). Behind Cloudflare: CF-Connecting-IP
GOTRUE_RATE_LIMIT_HEADER=
