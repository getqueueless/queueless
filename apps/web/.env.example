# Copy to .env.local and fill in real values there. .env.local is gitignored
# and never committed -- only this file (with placeholders) is tracked.

# Self-hosted Supabase project URL, e.g. https://supabase.yourdomain.tld
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-instance.example.com

# Public anon key (or a self-hosted stack's sb_publishable_... key -- the
# client factory treats this as one opaque string either way).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role key (or sb_secret_... key). Server-only: read only in
# server-side code (Route Handlers, Server Actions, Server Components),
# NEVER prefixed NEXT_PUBLIC_, NEVER imported by a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# FastAPI service base URL, for /predict and /metrics.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
