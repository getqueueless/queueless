# Shared secret the DB team's self-hosted GoTrue signs access tokens with (HS256).
# Never invent a second value here — pull the real one from the shared deploy env.
SUPABASE_JWT_SECRET=changeme

# Pooled connection, used for ordinary request-path queries.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Non-pooled (session) connection, required for LISTEN/NOTIFY. Point this at the
# direct Postgres port, never through a transaction-mode PgBouncer.
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/postgres

# "development" or "production". Gates Strict-Transport-Security (production only).
ENVIRONMENT=development

# Comma/JSON list of allowed browser origins for CORS. Never "*".
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8081"]

ROLE_CACHE_TTL_SECONDS=5.0
POLL_INTERVAL_SECONDS=5

# Razorpay (test mode). Optional -- payment routes return 503 until set, they
# never crash the app at startup. key_secret signs the checkout callback
# (order_id|payment_id); webhook_secret is a SEPARATE value from the Razorpay
# dashboard's webhook config, never the same as key_secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
