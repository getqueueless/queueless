# cp .env.example .env, then fill in real values. .env is gitignored -- never commit it.
POSTGRES_EXPORTER_DSN=postgresql://ql_metrics:change-me@supabase-db:5432/postgres?sslmode=disable
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=admin@lpu.lol
GRAFANA_ADMIN_PASSWORD=change-me
# Prometheus/Grafana bind 127.0.0.1 only (docker-compose.yml) -- these are host-side
# port numbers, not host_ip overrides; change only the number if it collides locally.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# postgres_exporter and Alertmanager publish no host port at all -- nothing outside
# this compose project reaches them directly, only Prometheus does, internally.
